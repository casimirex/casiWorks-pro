# CasiWorks Pro - local settings. Copy to .env and fill in what you need:
#   cp .env.example .env
# .env is ignored by git; never commit real tokens. Every value is optional.

# Library server (npm run server)
# Where documents, versions and API keys are kept (default ~/.casiworks)
CASIWORKS_DATA=
# Port on 127.0.0.1 (default 5180)
PORT=5180

# Browser checks and screenshots (npm run e2e, npm run perf, npm run docs:tutorial-shots)
# Chrome or Chromium to drive, when it is not in a standard place
CHROME_PATH=
# Run only the e2e checks whose name contains this text
E2E_ONLY=

# Git credentials for your own use (not read by the app)
git_username=
git_token=
